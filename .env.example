# Django Project Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# AI Agent API Keys (Configure at least one to enable live AI analysis)
# If both are empty, the application runs in high-fidelity local Mock AI demo mode.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database Configuration
# Leave DB_NAME empty to default automatically to zero-setup local SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# MongoDB Atlas Configuration
# Configure MONGODB_URI to use MongoDB Atlas (replaces SQLite)
MONGODB_URI=
MONGODB_DB_NAME=research_gap_finder
